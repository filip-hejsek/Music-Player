<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/queue_group_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/normal_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/medium_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/queue_group_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:alpha="0.8"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        android:textStyle="bold"
        tools:text="Album title · 12" />

    <ImageView
        android:id="@+id/queue_group_shuffle"
        android:layout_width="@dimen/song_image_size"
        android:layout_height="@dimen/song_image_size"
        android:contentDescription="@string/shuffle_group"
        android:padding="@dimen/medium_margin"
        android:src="@drawable/ic_shuffle_vector" />

    <ImageView
        android:id="@+id/queue_group_remove"
        android:layout_width="@dimen/song_image_size"
        android:layout_height="@dimen/song_image_size"
        android:contentDescription="@string/remove_group_from_queue"
        android:padding="@dimen/medium_margin"
        android:src="@drawable/ic_queue_remove_vector" />

</LinearLayout>
